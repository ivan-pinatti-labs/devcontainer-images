#!/bin/sh
: '
  What each workbench container runs as its main process. In the Codex
  workbench, puts the rule that lives in Codex own writable rules folder back
  to the image copy. Then waits; the terminal and the editor attach to the
  running container.
'
set -eu
if [ -f /usr/local/share/workbench/codex-workbench.rules ]; then
  mkdir -p "${CODEX_HOME}/rules"
  cp /usr/local/share/workbench/codex-workbench.rules "${CODEX_HOME}/rules/workbench.rules"
fi
exec sleep infinity
