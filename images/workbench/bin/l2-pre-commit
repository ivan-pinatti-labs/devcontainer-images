#!/bin/sh
: '
  pre-commit, run in L2. Used by the git hooks l2-hooks-install writes, and by
  the coding agents (their `pre-commit ...` commands are routed here).

  Usage:
    l2-pre-commit ARGS...      the same arguments pre-commit takes

  Hooks may write the paths the workbench or the host execute (formatters open
  files for writing even when they change nothing), so those are writable for
  the run. Afterwards they are compared with before, and a run in which a hook
  actually changed one fails, naming the files, so nothing lands there unseen.

  Hooks that can only work with the open internet (link checkers) are skipped
  here and left to CI: L2 runs hooks with no network. L2_SKIP_HOOKS overrides
  the list; SKIP adds to it, as with pre-commit itself.

  Exit status codes:
    1    a hook changed a protected path
    any  otherwise, the exit status of pre-commit
'
set -eu

skip="${L2_SKIP_HOOKS-markdown-link-check,lychee}"
[ -n "${SKIP:-}" ] && skip="${skip:+${skip},}${SKIP}"

protected() {
  for p in .devcontainer .vscode .claude .codex Makefile host; do
    [ -e "${p}" ] && find "${p}" -type f -exec sha256sum {} + 2>/dev/null
  done | sort
}

cd "$(git rev-parse --show-toplevel)"
before="$(protected)"
status=0
l2 --protected-rw --env "SKIP=${skip}" -- pre-commit "$@" || status=$?
after="$(protected)"
if [ "${before}" != "${after}" ]; then
  echo "" >&2
  echo "l2-pre-commit: a hook changed files the workbench or the host execute:" >&2
  printf '%s\n' "${before}" "${after}" | sort | uniq -u | awk '{print "  " $2}' | sort -u >&2
  echo "l2-pre-commit: review them (git diff) before committing again." >&2
  exit 1
fi
exit "${status}"
