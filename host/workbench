#!/bin/bash
: '
  Build, start and enter the workbench and its helpers. Runs on the host, and
  does nothing there but call podman. docs/LAYERS.md explains the layers.

  Usage:
    host/workbench build            build every image locally (localhost/*:local)
    host/workbench up [WORKSPACE]   start the helpers and the workbench
    host/workbench unlock           add the ssh key to the agent for 8 hours
    host/workbench shell [WORKSPACE]
                                    a shell in the running workbench
    host/workbench load-l2          copy the local L2 image into the workbench
    host/workbench status           what is running
    host/workbench down [WORKSPACE] stop the workbench and the helpers

  WORKSPACE is the folder mounted into the workbench, at its own path.
  Default: the main clone of the git repository you are in (so its
  worktrees are included), else the current directory.

  State kept on the host:
    ${XDG_DATA_HOME}/workbench/claude, codex  the agents logins and settings,
        separate from your own ~/.claude and ~/.codex
    ${XDG_RUNTIME_DIR}/workbench/gh           the gh broker socket
    ${XDG_RUNTIME_DIR}/devcontainer-ssh       the ssh-agent socket, known_hosts
    podman volume workbench-containers        L2 images inside the workbench

  Exit status codes:
    1  a prerequisite is missing (the message says which)
    2  usage error
'

set -o errexit
set -o nounset
set -o pipefail

TAG="${WORKBENCH_TAG:-local}"
BASE="localhost/devcontainer-base:${TAG}"
WB_IMAGE="localhost/devcontainer-workbench:${TAG}"
L2_IMAGE="localhost/devcontainer-l2:${TAG}"
BROKER_IMAGE="localhost/devcontainer-gh-broker:${TAG}"
PROXY_IMAGE="localhost/devcontainer-egress-proxy:${TAG}"

NET=workbench-egress
SUBNET=10.203.77.0/24
PROXY_IP=10.203.77.2
PROXY="http://${PROXY_IP}:8888"
LABEL_OPTS=(--security-opt label=type:container_engine_t --security-opt label=level:s0:c555,c666)

DATA="${XDG_DATA_HOME:-${HOME}/.local/share}/workbench"
RUN="${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is not set}"
GH_DIR="${RUN}/workbench/gh"
SSH_DIR="${RUN}/devcontainer-ssh"
SSH_KEY_DIR="${HOME}/.ssh/devcontainer"
HERE="$(cd "$(dirname "$0")/.." && pwd)"

die() { echo "workbench: $*" >&2; exit 1; }
running() { [ "$(podman inspect -f '{{.State.Running}}' "$1" 2>/dev/null)" = true ]; }

workspace() {
  local w="${1:-}"
  if [ -z "${w}" ]; then
    if common="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"; then
      w="$(dirname "${common}")"
    else
      w="${PWD}"
    fi
  fi
  (cd "${w}" && pwd)
}

wb_name() { echo "workbench-$(basename "$1" | tr -c 'A-Za-z0-9_.\n-' _)"; }

cmd_build() {
  podman build -t "${BASE}" "${HERE}/images/base"
  for i in workbench l2 gh-broker egress-proxy; do
    podman build --build-arg "BASE_IMAGE=${BASE}" -t "localhost/devcontainer-${i}:${TAG}" "${HERE}/images/${i}"
  done
}

start_proxy() {
  podman network exists "${NET}" \
    || podman network create --internal --disable-dns --subnet "${SUBNET}" "${NET}" >/dev/null
  running egress-proxy && return
  podman rm -f egress-proxy >/dev/null 2>&1 || true
  podman run -d --name egress-proxy \
    --network podman --network "${NET}:ip=${PROXY_IP}" \
    --cap-drop=all --security-opt no-new-privileges --read-only --tmpfs /run --tmpfs /tmp \
    "${PROXY_IMAGE}" >/dev/null
}

start_broker() {
  local ws="$1"
  running gh-broker && return
  podman secret exists gh-devcontainer \
    || die "no podman secret gh-devcontainer; create it: podman secret create gh-devcontainer <file holding the token>"
  mkdir -p "${GH_DIR}"
  chmod 700 "${RUN}/workbench" "${GH_DIR}"
  podman rm -f gh-broker >/dev/null 2>&1 || true
  podman run -d --name gh-broker \
    --userns=keep-id:uid=1000,gid=1000 "${LABEL_OPTS[@]}" \
    --cap-drop=all --security-opt no-new-privileges --read-only --tmpfs /tmp \
    --secret gh-devcontainer,type=env,target=GH_TOKEN \
    -v "${GH_DIR}:/run/gh-broker:Z" \
    -v "${ws}:${ws}:ro" \
    "${BROKER_IMAGE}" >/dev/null
}

start_ssh_agent() {
  running devcontainer-ssh-agent && return
  if [ ! -f "${SSH_KEY_DIR}/id_ed25519" ]; then
    echo "workbench: no ${SSH_KEY_DIR}/id_ed25519, so no ssh-agent; git push will not work (docs/LAYERS.md)" >&2
    return
  fi
  mkdir -p "${SSH_DIR}"
  chmod 700 "${SSH_DIR}"
  if [ ! -s "${SSH_DIR}/known_hosts" ]; then
    # GitHub's host keys, from GitHub's own API through the egress proxy's
    # image rather than the host, so the workbench can verify strictly.
    podman run --rm --network podman "${BASE}" \
      sh -c 'curl -fsS https://api.github.com/meta | jq -r ".ssh_keys[] | \"github.com \" + ."' \
      > "${SSH_DIR}/known_hosts"
  fi
  podman rm -f devcontainer-ssh-agent >/dev/null 2>&1 || true
  podman run -d --name devcontainer-ssh-agent \
    --network=none --cap-drop=all --read-only --security-opt no-new-privileges \
    --userns=keep-id "${LABEL_OPTS[@]}" \
    -v "${SSH_DIR}:/sock:Z" -v "${SSH_KEY_DIR}:/key:ro,Z" \
    --entrypoint ssh-agent "${WB_IMAGE}" -D -a /sock/agent.sock >/dev/null
}

start_workbench() {
  local ws="$1" name
  name="$(wb_name "${ws}")"
  running "${name}" && return
  mkdir -p "${DATA}/claude" "${DATA}/codex"
  podman volume exists workbench-containers || podman volume create workbench-containers >/dev/null
  podman rm -f "${name}" >/dev/null 2>&1 || true
  podman run -d --name "${name}" \
    --label workbench.workspace="${ws}" \
    --userns=keep-id:uid=1000,gid=1000 "${LABEL_OPTS[@]}" --device /dev/fuse \
    --network "${NET}" \
    -e HTTPS_PROXY="${PROXY}" -e HTTP_PROXY="${PROXY}" -e NO_PROXY=localhost,127.0.0.1 \
    -e https_proxy="${PROXY}" -e http_proxy="${PROXY}" -e no_proxy=localhost,127.0.0.1 \
    -e GIT_AUTHOR_NAME="$(git config --get user.name || true)" -e GIT_AUTHOR_EMAIL="$(git config --get user.email || true)" \
    -e GIT_COMMITTER_NAME="$(git config --get user.name || true)" -e GIT_COMMITTER_EMAIL="$(git config --get user.email || true)" \
    -e SSH_AUTH_SOCK=/run/devcontainer-ssh/agent.sock \
    -e GIT_SSH_COMMAND="ssh -o UserKnownHostsFile=/run/devcontainer-ssh/known_hosts -o StrictHostKeyChecking=yes -o HostKeyAlias=github.com -o Hostname=ssh.github.com -o Port=443 -o ProxyCommand='socat - PROXY:${PROXY_IP}:%h:%p,proxyport=8888'" \
    -v "${ws}:${ws}:Z" \
    -v "${DATA}/claude:/home/dev/.claude:Z" \
    -v "${DATA}/codex:/home/dev/.codex:Z" \
    -v "${GH_DIR}:/run/gh-broker" \
    -v "${SSH_DIR}:/run/devcontainer-ssh" \
    -v workbench-containers:/home/dev/.local/share/containers \
    -w "${ws}" \
    --entrypoint catatonit "${WB_IMAGE}" -- sleep infinity >/dev/null
}

cmd_up() {
  local ws
  ws="$(workspace "${1:-}")"
  mkdir -p "${SSH_DIR}" "${GH_DIR}"
  start_proxy
  start_broker "${ws}"
  start_ssh_agent
  start_workbench "${ws}"
  echo "workbench: up for ${ws} ($(wb_name "${ws}"))"
  echo "workbench: terminal: host/workbench shell; editor: Attach to Running Container, $(wb_name "${ws}")"
}

cmd_unlock() {
  running devcontainer-ssh-agent || die "the ssh-agent is not running; host/workbench up first"
  podman exec -it -e SSH_AUTH_SOCK=/sock/agent.sock devcontainer-ssh-agent \
    ssh-add -t 8h /key/id_ed25519
}

cmd_shell() {
  local ws name
  ws="$(workspace "${1:-}")"
  name="$(wb_name "${ws}")"
  running "${name}" || cmd_up "${ws}" >/dev/null
  local cwd="${PWD}"
  case "${cwd}/" in "${ws}"/*) ;; *) cwd="${ws}" ;; esac
  exec podman exec -it -w "${cwd}" "${name}" bash
}

cmd_load_l2() {
  local name
  name="$(podman ps --filter label=workbench.workspace --format '{{.Names}}' | head -n1)"
  [ -n "${name}" ] || die "no workbench running; host/workbench up first"
  podman save "${L2_IMAGE}" | podman exec -i "${name}" podman load
}

cmd_status() {
  podman ps -a --filter name='^(egress-proxy|gh-broker|devcontainer-ssh-agent|workbench-.*)$' \
    --format 'table {{.Names}}\t{{.Status}}\t{{.Image}}'
}

cmd_down() {
  local ws
  ws="$(workspace "${1:-}")"
  podman rm -f -t 5 "$(wb_name "${ws}")" gh-broker egress-proxy devcontainer-ssh-agent >/dev/null 2>&1 || true
  echo "workbench: down"
}

case "${1:-}" in
  build) cmd_build ;;
  up) cmd_up "${2:-}" ;;
  unlock) cmd_unlock ;;
  shell) cmd_shell "${2:-}" ;;
  load-l2) cmd_load_l2 ;;
  status) cmd_status ;;
  down) cmd_down "${2:-}" ;;
  -h | --help | help) sed -n '3,30p' "$0" ;;
  *) sed -n '3,20p' "$0" >&2; exit 2 ;;
esac
